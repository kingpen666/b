{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/dapi(.*)",
      "destination": "https://api.rule34.xxx/index.php$1"
    },
    {
      "source": "/api/autocomplete(.*)",
      "destination": "https://api.rule34.xxx/autocomplete.php$1"
    },
    {
      "source": "/media/:host([a-z0-9-]+)/:path*",
      "destination": "https://:host.rule34.xxx/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
