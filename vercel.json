{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/autocomplete(.*)",
      "destination": "https://api.rule34.xxx/autocomplete.php$1"
    },
    {
      "source": "/api/v2/(.*)",
      "destination": "https://r-34.xyz/api/v2/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
